MONGODB_URI=mongodb://127.0.0.1:27017/quarry-db?replicaSet=rs0
PORT=3000
APP_ENV=local

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
# Required in production, where Better Auth refuses its default secret.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
FRONTEND_URL=http://localhost:5173

# Cloudflare R2 (resume files). Use the non-production bucket's token locally.
# Setup steps: docs/r2-setup.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=quarry-staging

# Claude API. Not ANTHROPIC_API_KEY, which the cloud environment reserves.
APP_ANTHROPIC_API_KEY=
