MONGODB_URI=mongodb://127.0.0.1:27017/quarry-db?replicaSet=rs0
PORT=3000
APP_ENV=local

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
# Required in production, where Better Auth refuses its default secret.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
FRONTEND_URL=http://localhost:5173

# Cloudflare R2 (resume files). Use the non-production bucket's token locally.
# Setup steps: docs/r2-setup.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=quarry-staging

# Claude API key.
APP_ANTHROPIC_API_KEY=

# Resend (transactional email). Without a key, local runs log emails instead
# of sending them; staging and production refuse to send.
RESEND_API_KEY=
# Optional sender override; defaults to Quarry's noreply address.
EMAIL_FROM=

# Header the hosting edge sets to the client IP and overwrites on every
# request (Render: cf-connecting-ip). Leave empty locally: rate limits then key
# on the socket address. Never set it to a header callers can send past the edge.
TRUSTED_CLIENT_IP_HEADER=
