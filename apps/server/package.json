{
  "name": "server",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.{ts,mts}\" \"scripts/**/*.ts\"",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "migrate:status": "migrate-mongo status -f migrate-mongo-config.js",
    "migrate:up": "migrate-mongo up -f migrate-mongo-config.js",
    "migrate:down": "migrate-mongo down -f migrate-mongo-config.js",
    "seed": "ts-node --transpile-only -P tsconfig.migrate-mongo.json scripts/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.11",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^11.2.11",
    "@nestjs/mongoose": "^12.0.1",
    "@nestjs/platform-express": "^11.2.11",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "1.7.27",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "migrate-mongo": "^14.0.7",
    "mongodb": "^7.9.1",
    "mongoose": "^9.12.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.11",
    "@quarry/lint-rules": "workspace:*",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.0",
    "@types/migrate-mongo": "^14.0.0",
    "@types/node": "^22.20.2",
    "@types/supertest": "^6.0.0",
    "mongodb-memory-server": "^11.4.0",
    "oxlint": "^1.94.0",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-loader": "^9.5.4",
    "tsconfig-paths": "^4.2.0",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.1.1"
  }
}
